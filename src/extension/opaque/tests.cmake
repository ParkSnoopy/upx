if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Windows)$" OR
   NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$" OR
   NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    return()
endif()

set(opaque_fixture_source "${CMAKE_CURRENT_LIST_DIR}/opaque_test.c")
add_executable(upx_opaque_test "${opaque_fixture_source}")
target_compile_features(upx_opaque_test PRIVATE c_std_11)
target_link_libraries(upx_opaque_test PRIVATE ${CMAKE_DL_LIBS})
add_library(upx_opaque_fixture SHARED "${opaque_fixture_source}")
target_compile_features(upx_opaque_fixture PRIVATE c_std_11)
target_compile_definitions(upx_opaque_fixture PRIVATE UPX_OPAQUE_SHARED_FIXTURE=1)
set(opaque_targets "$<TARGET_FILE:upx_opaque_fixture>")
set(opaque_kinds main library)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_library(upx_opaque_tight_fixture SHARED "${opaque_fixture_source}")
    target_compile_features(upx_opaque_tight_fixture PRIVATE c_std_11)
    target_compile_definitions(upx_opaque_tight_fixture PRIVATE UPX_OPAQUE_SHARED_FIXTURE=1)
    target_compile_options(upx_opaque_tight_fixture PRIVATE -fcf-protection=full)
    target_link_options(upx_opaque_tight_fixture PRIVATE -Wl,-z,noseparate-code -Wl,--build-id=none
                        -Wl,-z,ibt -Wl,-z,shstk)
    list(APPEND opaque_kinds library-tight)
    list(APPEND opaque_targets "$<TARGET_FILE:upx_opaque_tight_fixture>")
    upx_add_test(upx-opaque-original-library-tight upx_opaque_test --load "$<TARGET_FILE:upx_opaque_tight_fixture>")
endif()

upx_add_test(upx-opaque-original-main upx_opaque_test)
upx_add_test(upx-opaque-original-library upx_opaque_test --load "$<TARGET_FILE:upx_opaque_fixture>")

foreach(method IN ITEMS nrv2b nrv2d nrv2e lzma)
    foreach(kind IN LISTS opaque_kinds)
        if(kind STREQUAL "main")
            set(input "$<TARGET_FILE:upx_opaque_test>")
            set(suffix "${CMAKE_EXECUTABLE_SUFFIX}")
        else()
            if(kind STREQUAL "library-tight")
                set(input "$<TARGET_FILE:upx_opaque_tight_fixture>")
            else()
                set(input "$<TARGET_FILE:upx_opaque_fixture>")
            endif()
            set(suffix "${CMAKE_SHARED_LIBRARY_SUFFIX}")
        endif()
        foreach(mode IN ITEMS normal opaque)
            set(name "upx-opaque-${kind}-${method}-${mode}")
            set(packed "${CMAKE_CURRENT_BINARY_DIR}/XTesting/$<CONFIG>/${name}${suffix}")
            set(unpacked "${CMAKE_CURRENT_BINARY_DIR}/XTesting/$<CONFIG>/${name}-unpacked${suffix}")
            set(options "")
            if(mode STREQUAL "opaque")
                set(options --opaque)
            endif()
            upx_add_test(${name}-pack upx -3 --${method} ${options} --strip-relocs=0
                         "${input}" --force-overwrite -o "${packed}")
            set_tests_properties(${name}-pack PROPERTIES FIXTURES_SETUP "${name}-packed")
            upx_add_test(${name}-integrity upx -t "${packed}")
            upx_add_test(${name}-unpack upx -d "${packed}" --force-overwrite -o "${unpacked}")
            set_tests_properties(${name}-unpack PROPERTIES FIXTURES_SETUP "${name}-unpacked")
            if(kind STREQUAL "main")
                upx_add_test(${name}-run "${packed}")
                upx_add_test(${name}-recovered-run "${unpacked}")
            else()
                list(APPEND opaque_targets "${packed}" "${unpacked}")
                upx_add_test(${name}-run upx_opaque_test --load "${packed}")
                upx_add_test(${name}-recovered-run upx_opaque_test --load "${unpacked}")
                set(main_name "upx-opaque-main-${method}-${mode}")
                set(main_packed "${CMAKE_CURRENT_BINARY_DIR}/XTesting/$<CONFIG>/${main_name}${CMAKE_EXECUTABLE_SUFFIX}")
                upx_add_test(${name}-bundle-run "${main_packed}" --load "${packed}")
                set_tests_properties(${name}-bundle-run PROPERTIES FIXTURES_REQUIRED "${main_name}-packed;${name}-packed" TIMEOUT 20)
                if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
                    upx_add_test(${name}-lazy upx_opaque_test --load-lazy "${packed}")
                    set_tests_properties(${name}-lazy PROPERTIES FIXTURES_REQUIRED "${name}-packed" TIMEOUT 20)
                endif()
            endif()
            set_tests_properties(${name}-integrity ${name}-unpack ${name}-run
                                 PROPERTIES FIXTURES_REQUIRED "${name}-packed" TIMEOUT 20)
            set_tests_properties(${name}-recovered-run PROPERTIES FIXTURES_REQUIRED "${name}-unpacked" TIMEOUT 20)
            if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
                upx_add_test(${name}-exact "${CMAKE_COMMAND}" -E compare_files "${input}" "${unpacked}")
                set_tests_properties(${name}-exact PROPERTIES FIXTURES_REQUIRED "${name}-unpacked")
            endif()
            if(mode STREQUAL "normal")
                set(normal_unpacked "${unpacked}")
                set(normal_fixture "${name}-unpacked")
            else()
                # PE recovery retains UPX's existing header normalization.
                upx_add_test(${name}-recovery-parity "${CMAKE_COMMAND}" -E compare_files "${normal_unpacked}" "${unpacked}")
                set_tests_properties(${name}-recovery-parity PROPERTIES FIXTURES_REQUIRED "${normal_fixture};${name}-unpacked")
            endif()
        endforeach()
    endforeach()
endforeach()

string(REPLACE ";" "\", \"" opaque_targets "${opaque_targets}")
target_compile_definitions(upx_opaque_test PRIVATE "UPX_OPAQUE_TARGETS=\"${opaque_targets}\"")
